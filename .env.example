# ─── Required ──────────────────────────────────────────────────────────
# MariaDB / MySQL connection (used by both app and `pnpm db:push`)
DATABASE_URL=mysql://btc:change-me@localhost:3306/btc_trading

# JWT/cookie signing secret. Any random 32+ char string.
JWT_SECRET=replace-with-long-random-string

# ─── docker-compose only ───────────────────────────────────────────────
# Used by docker-compose.yml to provision the MariaDB container.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=btc_trading
MARIADB_USER=btc
MARIADB_PASSWORD=change-me

# Host port the app is published on (loopback only — Tailscale Serve fronts it).
APP_PORT=3002

# ─── Optional: Telegram trade alerts ───────────────────────────────────
# Create a bot via @BotFather, then DM it and grab your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional: Manus platform integrations ─────────────────────────────
# Leave blank for self-hosted use. Setting these re-enables Manus OAuth,
# Forge LLM (gemini-2.5-flash via /v1/chat/completions), in-app
# notifications, and S3-style storage proxy.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ─── OKX exchange ──────────────────────────────────────────────────────
# Market data from OKX needs NO credentials — it is already the primary candle
# and price source. The variables below are only needed to place orders.
#
# Verify any change with:  pnpm tsx server/scripts/okxCheck.ts
#
# Regional site. Singapore accounts are on the global site (the default).
# EEA: https://my.okx.com   US: https://app.okx.com   TR: https://tr.okx.com
OKX_BASE_URL=https://www.okx.com
OKX_INST_ID=BTC-USDT

# API credentials. Create at OKX → Account → API.
# Permissions: Read + Trade ONLY. Never enable Withdraw.
# Restrict the key to this host's egress IP.
# Demo and live are SEPARATE keys — a live key will not work against demo.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 1 = route every request to OKX's simulated environment. Requires a key
# created under Demo Trading. Leave at 1 until the demo run is trusted.
OKX_DEMO=1

# Where trades execute:
#   internal   in-database paper ledger (default, no OKX account touched)
#   okx-demo   real orders against OKX demo — requires OKX_DEMO=1
#   okx-live   real orders with real money — requires OKX_DEMO unset/0
# Misconfiguration always falls back to `internal` rather than guessing.
EXECUTION_VENUE=internal

# Per-side trading cost charged by the INTERNAL paper ledger, in basis points.
#
# OKX spot, Lv1 regular tier (no OKB discount): maker 0.080%, taker 0.100%.
# The strategy places market orders, so taker applies → TRADING_FEE_BPS=10.
# Confirm your own tier with `pnpm okx:check`, which reads
# GET /api/v5/account/trade-fee and prints the value to use.
#
# Defaults to 0 here to preserve the original fee-free paper track record.
# That default flatters high-turnover strategies badly: at 10 bps the current
# strategy's 695 trades cost ~3.3% of the seed over 3 months, and at OKX's
# 26 bps-equivalent round trip it turned a -6.5% paper result into -14.7%.
TRADING_FEE_BPS=0

# Per-side cost the WALK-FORWARD OPTIMIZER assumes when scoring parameters.
#
# Deliberately separate from TRADING_FEE_BPS. That one decides what the paper
# ledger charges, and therefore whether the recorded equity curve stays
# comparable over time. This one decides which parameters get selected to run
# against a real exchange, so it should always assume real costs even when the
# paper ledger is fee-free.
#
# Defaults to 10 (OKX Lv1 taker, 0.100%). Set to 0 only to reproduce the old
# fee-blind behaviour for analysis.
OPTIMIZER_FEE_BPS=10

# ─── Misc ──────────────────────────────────────────────────────────────
# Set to 1 to suppress the in-process scheduler (e.g. when running migrations only).
DISABLE_INTERNAL_SCHEDULER=
