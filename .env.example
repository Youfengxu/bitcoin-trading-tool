# ─── Required ──────────────────────────────────────────────────────────
# MariaDB / MySQL connection (used by both app and `pnpm db:push`)
DATABASE_URL=mysql://btc:change-me@localhost:3306/btc_trading

# JWT/cookie signing secret. Any random 32+ char string.
JWT_SECRET=replace-with-long-random-string

# ─── docker-compose only ───────────────────────────────────────────────
# Used by docker-compose.yml to provision the MariaDB container.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=btc_trading
MARIADB_USER=btc
MARIADB_PASSWORD=change-me

# Host port the app is published on (loopback only — Tailscale Serve fronts it).
APP_PORT=3002

# ─── Optional: Telegram trade alerts ───────────────────────────────────
# Create a bot via @BotFather, then DM it and grab your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional: Manus platform integrations ─────────────────────────────
# Leave blank for self-hosted use. Setting these re-enables Manus OAuth,
# Forge LLM (gemini-2.5-flash via /v1/chat/completions), in-app
# notifications, and S3-style storage proxy.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ─── OKX exchange ──────────────────────────────────────────────────────
# Market data from OKX needs NO credentials — it is already the primary candle
# and price source. The variables below are only needed to place orders.
#
# Verify any change with:  pnpm tsx server/scripts/okxCheck.ts
#
# Regional site. An OKX account only authenticates against the site it was
# registered on; a key from elsewhere fails with 50119 "API key doesn't exist".
#
# DO NOT infer this from your country. Read it from the URL bar while logged in
# and managing your API keys — an account at my.okx.com/en-sg is on my.okx.com,
# not the global site. `pnpm okx:check` probes every site and tells you which
# one recognises your key.
#
#   https://www.okx.com   global
#   https://my.okx.com    EEA and SG accounts among others
#   https://app.okx.com   US
#   https://tr.okx.com    TR
OKX_BASE_URL=https://www.okx.com
OKX_INST_ID=BTC-USDT

# API credentials. Create at OKX → Account → API.
# Permissions: Read + Trade ONLY. Never enable Withdraw.
# Restrict the key to this host's egress IP.
# Demo and live are SEPARATE keys — a live key will not work against demo.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 1 = route every request to OKX's simulated environment. Requires a key
# created under Demo Trading. Leave at 1 until the demo run is trusted.
OKX_DEMO=1

# Whether a REAL book runs beside the paper ledger.
#
# The paper ledger always runs — it is the analysis baseline and keeps its own
# equity curve. This only decides whether OKX orders are placed as well:
#   internal   paper ledger only (default, no OKX account touched)
#   okx-demo   paper ledger AND real orders on OKX demo — requires OKX_DEMO=1
#   okx-live   paper ledger AND real orders with real money — OKX_DEMO unset/0
#
# Lockstep: if the real venue does not fill, the paper book skips the trade too,
# so both books always hold the same trades and differ only in execution
# quality. Misconfiguration falls back to paper-only rather than guessing.
EXECUTION_VENUE=internal

# Per-side trading cost charged by the INTERNAL paper ledger, in basis points.
#
# OKX spot, Lv1 regular tier (no OKB discount): maker 0.080%, taker 0.100%.
# The strategy places market orders, so taker applies → TRADING_FEE_BPS=10.
# Confirm your own tier with `pnpm okx:check`, which reads
# GET /api/v5/account/trade-fee and prints the value to use.
#
# Defaults to 0 here to preserve the original fee-free paper track record.
# That default flatters high-turnover strategies badly: at 10 bps the current
# strategy's 695 trades cost ~3.3% of the seed over 3 months, and at OKX's
# 26 bps-equivalent round trip it turned a -6.5% paper result into -14.7%.
TRADING_FEE_BPS=0

# Minimum bars between executed trades. 0 = no cooldown.
#
# Evidence at minConfidence 0.45 (sweep on 2026-02→08 1h candles, 10bps):
#   cooldown   trades/qtr  return   |  trades/qtr  return
#              (bear)      (bear)   |  (bull)      (bull)
#      0          62       +1.51%   |    212       +6.81%
#      4          33       +0.09%   |    101       +6.24%
#     12          22       -0.20%   |     66       +6.17%
#     24          16       -0.23%   |     51       +6.81%
#
# Shorter is both MORE FREQUENT and slightly BETTER in both regimes. The 12-bar
# default came from a backtest run at minConfidence 0.30, where signals fired
# constantly and throttling helped; at 0.45 the threshold already filters and
# the cooldown only removes good trades.
#
# The asymmetry matters: frequency is nearly free from this lever and expensive
# from the confidence threshold — dropping minConfidence 0.45 -> 0.40 costs
# 5-7pp in a bear window at EVERY cooldown setting. Raise frequency here, not
# there.
TRADE_COOLDOWN_BARS=0

# Capital the strategy may deploy on the OKX book, in SGD. 0 / unset = use the
# whole account balance.
#
# Demo funds cannot be withdrawn: OKX seeds every demo account with a fixed
# basket (1 BTC, 10k USDT, 10k USD, 10k SGD, 5k USDC, 1 ETH — around SGD 93k)
# and restores it periodically, so there is no way to trade the account down to
# a chosen size. With this set, the tool tracks its OWN cash/BTC ledger for the
# venue and uses the real balance only as a solvency check — which also makes
# the book immune to OKX's resets.
#
# The book is seeded on first use at this value, split to match the paper
# book's current BTC weight so the two are comparable from the start.
#
# NOTE: OKX lists no BTC-SGD market (SGD pairs only with stablecoins), so the
# cash leg is USDT. SGD is a display and sizing currency, never what is held.
OKX_BOOK_CAPITAL_SGD=10000

# Per-side cost the WALK-FORWARD OPTIMIZER assumes when scoring parameters.
#
# Deliberately separate from TRADING_FEE_BPS. That one decides what the paper
# ledger charges, and therefore whether the recorded equity curve stays
# comparable over time. This one decides which parameters get selected to run
# against a real exchange, so it should always assume real costs even when the
# paper ledger is fee-free.
#
# Defaults to 10 (OKX Lv1 taker, 0.100%). Set to 0 only to reproduce the old
# fee-blind behaviour for analysis.
OPTIMIZER_FEE_BPS=10

# Currencies whose hourly positioning/flow stats are recorded to the
# positioning_snapshots table. Empty-ish default covers the liquid majors.
#
# Why this exists: exchanges discard derivatives statistics quickly — OKX
# serves 30 days of hourly data, Binance 21, Bybit 8, and NONE of them serve it
# retroactively (verified 2026-08-16). A positioning-based signal therefore
# cannot be backtested on history that does not exist. The collector writes it
# down as it happens; ~2,000 hourly bars per currency accumulate in 3 months.
#
# The collector re-submits its whole 30-day window each run and lets the
# (ccy, ts) unique constraint drop duplicates, so it is self-healing after
# downtime and backfills 30 days on the very first run.
POSITIONING_CCYS=BTC,ETH,SOL,XRP,DOGE,LINK

# ─── Misc ──────────────────────────────────────────────────────────────
# Set to 1 to suppress the in-process scheduler (e.g. when running migrations only).
DISABLE_INTERNAL_SCHEDULER=
